# =====================================================================
# newCRM — переменные окружения (шаблон). Реальные значения — только в
# runtime App Platform, НЕ в коде/образе/git. Один файл-справочник;
# каждый сервис получает свой набор в своём окружении App Platform.
# =====================================================================

# ---------- Общие (PostgreSQL + S3) ----------
DATABASE_URL=postgresql://user:pass@host:5432/default_db
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
CALL_TIMEZONE_OFFSET=+03:00

# ---------- orders-webhook ----------
WEBHOOK_SECRET=
GSHEETS_SECRET=
# PORT задаётся платформой App Platform

# ---------- email-уведомления (orders-webhook) — Yandex Cloud Postbox ----------
# Если POSTBOX_KEY_ID/POSTBOX_SECRET не заданы — письма НЕ отправляются (feature-флаг выключен).
# Ключи: сервисный аккаунт postbox-user с ролью postbox.sender → статический ключ доступа.
# Отправка идёт по 443 (HTTP API): почтовые порты на App Platform закрыты.
# Тема, отправитель и контакты клуба — константы в shared/mailer.py.
POSTBOX_KEY_ID=
POSTBOX_SECRET=
POSTBOX_REGION=ru-central1
POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net

# ---------- БСО из Google Sheets (забор из таблицы) ----------
# Заменяет Apps Script-отправителя: CRM сама читает лист «БАЛАНС» раз в 5 минут.
# GSHEETS_SA_B64 — ключ сервисного аккаунта Google, закодированный в base64 (одной строкой).
# Таблица должна быть расшарена роботу (client_email из ключа) на просмотр.
GSHEETS_PULL_ENABLED=0
GSHEETS_SA_B64=
GSHEETS_SPREADSHEET_ID=
GSHEETS_SHEET_NAME=БАЛАНС
GSHEETS_DATE_FROM=2026-08-13
GSHEETS_PULL_INTERVAL_SECONDS=300

# ---------- calls-worker ----------
MAIL_IMAP_HOST=imap.yandex.ru
MAIL_IMAP_PORT=993
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX
PARSER_LOOKBACK_HOURS=24
WORKER_INTERVAL_SECONDS=300
# health-HTTP для App Platform healthcheck
WORKER_HEALTH_PORT=8081

# ---------- crm-api ----------
TELEGRAM_BOT_TOKEN=
# PORT задаётся платформой App Platform
