# =====================================================================
# newCRM — переменные окружения (шаблон). Реальные значения — только в
# runtime App Platform, НЕ в коде/образе/git. Один файл-справочник;
# каждый сервис получает свой набор в своём окружении App Platform.
# =====================================================================

# ---------- Общие (PostgreSQL + S3) ----------
DATABASE_URL=postgresql://user:pass@host:5432/default_db
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
CALL_TIMEZONE_OFFSET=+03:00

# ---------- orders-webhook ----------
WEBHOOK_SECRET=
GSHEETS_SECRET=
# PORT задаётся платформой App Platform

# ---------- email-уведомления (orders-webhook) ----------
# Если SMTP_HOST не задан — письма НЕ отправляются (feature-флаг выключен).
# Остальные параметры письма (тема, контакты клуба и т.д.) — константы в shared/mailer.py.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------- calls-worker ----------
MAIL_IMAP_HOST=imap.yandex.ru
MAIL_IMAP_PORT=993
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX
PARSER_LOOKBACK_HOURS=24
WORKER_INTERVAL_SECONDS=300
# health-HTTP для App Platform healthcheck
WORKER_HEALTH_PORT=8081

# ---------- crm-api ----------
TELEGRAM_BOT_TOKEN=
# PORT задаётся платформой App Platform
