# Переменные воркера разбора звонков (calls_worker) для российского VPS.
# Скопируйте в .env.worker и заполните значения. Файл НЕ коммитить.
#
# Значения DATABASE_URL / S3_* — те же, что стоят в переменных приложения
# App Platform (их можно скопировать из панели: приложение ZCminiAPP → Переменные).

# --- База данных (обязательно) ---
DATABASE_URL=postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@201.34.136.152:5432/ZC_orders

# --- Хранилище записей (обязательно) ---
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Почта с записями звонков (обязательно) ---
MAIL_IMAP_HOST=imap.yandex.ru
MAIL_IMAP_PORT=993
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX

# --- Параметры разбора ---
# Окно разбора писем в часах. 24 по умолчанию; если сервер может простаивать
# (выключение, переезд) — ставьте 72 и больше: повторов не будет, дубли
# отсекаются по UID письма и хэшу MP3.
PARSER_LOOKBACK_HOURS=72
WORKER_INTERVAL_SECONDS=300
CALL_TIMEZONE_OFFSET=+03:00

# --- Уведомления о сбоях (необязательно) ---
# TELEGRAM_BOT_TOKEN=<токен бота клуба>
# TELEGRAM_ALERT_CHAT_ID=<чат, куда писать об ошибках; для группы id вида -100...>
# WORKER_ALERT_EVERY_SECONDS=3600
