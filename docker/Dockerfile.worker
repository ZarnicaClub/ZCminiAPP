FROM python:3.12-slim

WORKDIR /app

# См. комментарий в Dockerfile.app: установка зависимостей только из wheels/.
COPY wheels ./wheels
COPY requirements.txt .
RUN pip install --no-cache-dir --no-index --find-links=wheels -r requirements.txt

COPY shared ./shared
COPY calls_worker ./calls_worker

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN useradd --create-home appuser
USER appuser

EXPOSE 8081
CMD ["python", "-m", "calls_worker.main"]
